<Window x:Class="Pic.Editor.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Pic.Editor"
        Title="Pic - Image Editor"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Topmost="True">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Background="#2D2D30" Margin="0">
            <Button Name="BtnPointer" ToolTip="Pointer (Esc)" Margin="2" Click="ToolButton_Click"
                    Tag="Pointer" Width="36" Height="36">
                <TextBlock Text="&#x1F6B6;" FontSize="16"/>
            </Button>
            <Separator/>
            <Button Name="BtnPen" ToolTip="Pen" Margin="2" Click="ToolButton_Click"
                    Tag="Pen" Width="36" Height="36" Background="#333">
                <TextBlock Text="&#x270F;" FontSize="16"/>
            </Button>
            <Button Name="BtnHighlighter" ToolTip="Highlighter" Margin="2" Click="ToolButton_Click"
                    Tag="Highlighter" Width="36" Height="36">
                <TextBlock Text="&#x1F4D9;" FontSize="16"/>
            </Button>
            <Separator/>
            <Button Name="BtnRect" ToolTip="Rectangle" Margin="2" Click="ToolButton_Click"
                    Tag="Rectangle" Width="36" Height="36">
                <TextBlock Text="&#x25AD;" FontSize="16"/>
            </Button>
            <Button Name="BtnEllipse" ToolTip="Ellipse" Margin="2" Click="ToolButton_Click"
                    Tag="Ellipse" Width="36" Height="36">
                <TextBlock Text="&#x2B2D;" FontSize="16"/>
            </Button>
            <Button Name="BtnArrow" ToolTip="Arrow" Margin="2" Click="ToolButton_Click"
                    Tag="Arrow" Width="36" Height="36">
                <TextBlock Text="&#x2192;" FontSize="18"/>
            </Button>
            <Button Name="BtnText" ToolTip="Text" Margin="2" Click="ToolButton_Click"
                    Tag="Text" Width="36" Height="36">
                <TextBlock Text="A" FontWeight="Bold" FontSize="18" Foreground="White"/>
            </Button>
            <Separator/>
            <Button Name="BtnColor" ToolTip="Color" Margin="2" Click="ColorButton_Click" Width="36" Height="36">
                <Rectangle Name="ColorPreview" Width="20" Height="20" Fill="Red" RadiusX="3" RadiusY="3"/>
            </Button>
            <Slider Name="ThicknessSlider" Width="80" Minimum="1" Maximum="20" Value="3"
                    ValueChanged="ThicknessSlider_ValueChanged" ToolTip="Line Thickness" Margin="6,0"/>
            <Separator/>
            <Button Name="BtnUndo" ToolTip="Undo (Ctrl+Z)" Margin="2" Click="UndoButton_Click" Width="36" Height="36">
                <TextBlock Text="&#x21B6;" FontSize="18"/>
            </Button>
            <Button Name="BtnRedo" ToolTip="Redo (Ctrl+Y)" Margin="2" Click="RedoButton_Click" Width="36" Height="36">
                <TextBlock Text="&#x21B7;" FontSize="18"/>
            </Button>
            <Separator/>
            <Button Name="BtnSave" ToolTip="Save (Ctrl+S)" Margin="2" Click="SaveButton_Click" Width="80" Height="36">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4BE;" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Save" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="BtnCopy" ToolTip="Copy to Clipboard (Ctrl+C)" Margin="2" Click="CopyButton_Click" Width="80" Height="36">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4CB;" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Copy" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Name="BtnClose" ToolTip="Discard (Esc)" Margin="2" Click="CloseButton_Click" Width="80" Height="36">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2716;" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Close" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E">
            <editor:ImageEditorCanvas x:Name="EditorCanvas"
                                       Width="Auto" Height="Auto"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       StateChanged="EditorCanvas_StateChanged"/>
        </ScrollViewer>
    </Grid>
</Window>
