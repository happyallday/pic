<Window x:Class="Pic.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pic - Settings"
        Width="500" Height="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Save" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Save Directory:" Width="100" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSaveDir" Width="240" Margin="4,0"/>
                            <Button Content="..." Width="30" Click="BrowseSaveDir_Click" Padding="4,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Format:" Width="100" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFormat" Width="120">
                                <ComboBoxItem Content="PNG" Tag="Png"/>
                                <ComboBoxItem Content="JPEG" Tag="Jpeg"/>
                                <ComboBoxItem Content="BMP" Tag="Bmp"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="ChkAutoCopy" Content="Auto copy to clipboard" Margin="0,4"/>
                        <CheckBox x:Name="ChkOpenEditor" Content="Open editor after capture" Margin="0,4"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Startup" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="ChkShowToolbar" Content="Show floating toolbar on startup" Margin="0,4"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Capture" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Delay (seconds):" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtDelaySeconds" Width="60"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Recording" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Recordings Directory:" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRecordDir" Width="200" Margin="4,0"/>
                            <Button Content="..." Width="30" Click="BrowseRecordDir_Click" Padding="4,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Frame Rate:" Width="120" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFrameRate" Width="80">
                                <ComboBoxItem Content="15" Tag="15"/>
                                <ComboBoxItem Content="30" Tag="30"/>
                                <ComboBoxItem Content="60" Tag="60"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Hotkeys" Margin="0,0,0,8">
                    <StackPanel x:Name="HotkeyPanel" Margin="8">
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="4" Click="CancelButton_Click"/>
            <Button Content="Save" Width="80" Margin="4" Click="SaveButton_Click"
                    Background="#0078D4" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
