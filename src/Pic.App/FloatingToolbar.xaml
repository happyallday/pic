<Window x:Class="Pic.App.FloatingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pic"
        Width="260" Height="48"
        WindowStyle="None" AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Left="100" Top="100"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#2D2D30" CornerRadius="6" BorderBrush="#444" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
            <Button Style="{StaticResource ToolbarButton}" ToolTip="Region Capture (Ctrl+Shift+X)"
                    Click="BtnRegion_Click">
                <TextBlock Text="&#x25A8;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" ToolTip="Full Screen (PrintScreen)"
                    Click="BtnFullScreen_Click">
                <TextBlock Text="&#x1F5B5;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" ToolTip="Active Window (Alt+PrintScreen)"
                    Click="BtnWindow_Click">
                <TextBlock Text="&#x1F4CB;" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" ToolTip="Scrolling Capture (Ctrl+Shift+S)"
                    Click="BtnScrolling_Click">
                <TextBlock Text="&#x1F4DC;" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" ToolTip="Screen Recording (Ctrl+Shift+R)"
                    Click="BtnRecording_Click">
                <TextBlock Text="&#x25CF;" FontSize="14" Foreground="#FF4444"/>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" ToolTip="Settings"
                    Click="BtnSettings_Click">
                <TextBlock Text="&#x2699;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource ToolbarButton}" ToolTip="Close Toolbar"
                    Click="BtnClose_Click">
                <TextBlock Text="&#x2716;" FontSize="12"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
